# =============================================================================
# Halal Keeps — Environment Configuration Template
# =============================================================================
# HOW TO USE
# ----------
# Local (XAMPP):
#   1. cp .env.example .env
#   2. Set APP_SUBFOLDER to your XAMPP folder name (e.g. "halal_final")
#   3. Set APP_ENV=local
#   4. Fill in DB credentials (XAMPP defaults shown below)
#
# Production (shared hosting / VPS):
#   1. Upload all project files to your domain's public_html (or www) folder
#   2. cp .env.example .env  on the server (via SSH or File Manager)
#   3. Leave APP_SUBFOLDER empty — the app runs at the domain root
#   4. Set APP_ENV=production
#   5. Fill in your real DB credentials from your hosting control panel
#   6. Set real Google OAuth and PayMongo keys
#   7. Generate a strong FIELD_ENCRYPT_KEY (see tip below)
#   8. In .htaccess, uncomment the HTTPS redirect block
#   9. NEVER commit your real .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# APP_SUBFOLDER — XAMPP only. The folder name under htdocs the project lives in.
# Leave EMPTY on production (app is at domain root: https://yourdomain.com/).
# Example local:       APP_SUBFOLDER='halal_final'
# Example production:  APP_SUBFOLDER=''
APP_SUBFOLDER=''

# APP_ENV — Controls error display and debug output.
# Use 'local' for development, 'production' for live hosting.
APP_ENV='production'

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Get these values from your hosting control panel (cPanel → MySQL Databases).
# On cPanel the host is usually 127.0.0.1 or localhost.
DB_HOST='127.0.0.1'
DB_PORT='3306'
DB_USER='your_db_username'
DB_PASS='your_db_password'
DB_NAME='your_db_name'

# -----------------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------------
# 1. Go to https://console.cloud.google.com/ → APIs & Services → Credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add your production redirect URI:
#      https://yourdomain.com/auth/google_callback.php
# 4. Paste the Client ID and Secret below
GOOGLE_CLIENT_ID='your-google-client-id.apps.googleusercontent.com'
GOOGLE_CLIENT_SECRET='your-google-client-secret'

# -----------------------------------------------------------------------------
# PayMongo
# -----------------------------------------------------------------------------
# Test keys:  https://dashboard.paymongo.com/developers (use sk_test_ / pk_test_)
# Live keys:  switch to sk_live_ / pk_live_ on production after going live
PAYMONGO_SECRET_KEY='sk_live_your_paymongo_secret_key'
PAYMONGO_PUBLIC_KEY='pk_live_your_paymongo_public_key'
# Webhook secret: go to Webhooks → create webhook → copy the signing secret (whsec_...)
PAYMONGO_WEBHOOK_SECRET='whsec_your_webhook_signing_secret'

# -----------------------------------------------------------------------------
# Encryption key for sensitive database fields
# -----------------------------------------------------------------------------
# Generate a strong key with:
#   php -r "echo bin2hex(random_bytes(32));"
# Copy the output here. Keep this secret — losing it means encrypted data
# in the database cannot be decrypted.
FIELD_ENCRYPT_KEY='replace-with-a-64-char-hex-string-generated-by-php'

# -----------------------------------------------------------------------------
# HaCeRa AI Readiness Insights (disabled by default)
# -----------------------------------------------------------------------------
# Set HACERA_AI_ENABLED=true only after the migration, mocked tests, access
# review, and cost limits are approved. This adapter expects an OpenAI-compatible
# chat-completions JSON endpoint; credentials are used server-side only.
HACERA_AI_ENABLED='false'
HACERA_AI_PROVIDER='openai_compatible'
HACERA_AI_ENDPOINT='https://your-provider.example/v1/chat/completions'
HACERA_AI_API_KEY='replace-with-server-side-ai-key'
HACERA_AI_MODEL='your-structured-json-model'
HACERA_AI_TIMEOUT_SECONDS='30'
# Retries transient network, 429, and 5xx provider responses with
# exponential backoff (1s, 2s, 4s by default). Set 0 to disable.
HACERA_AI_MAX_RETRIES='3'
HACERA_AI_MAX_RUNS_PER_DAY='10'
# false uses the database queue + scripts/process_hacera_ai_queue.php.
# true is only suitable for development or hosts without a cron worker.
HACERA_AI_PROCESS_INLINE='false'

# -----------------------------------------------------------------------------
# Ingredient-to-menu mapping and batch inventory (disabled by default)
# -----------------------------------------------------------------------------
# Apply database/ingredient_menu_mapping_migration.sql and validate staging
# before enabling operational inventory controls. AI remains optional.
INGREDIENT_MENU_MAPPING_ENABLED='false'
INGREDIENT_LIMITED_PORTION_THRESHOLD='10'
INGREDIENT_MENU_AI_ENABLED='false'
INGREDIENT_MENU_AI_PROVIDER='openai_compatible'
INGREDIENT_MENU_AI_ENDPOINT='https://your-provider.example/v1/chat/completions'
INGREDIENT_MENU_AI_API_KEY='replace-with-server-side-ai-key'
INGREDIENT_MENU_AI_MODEL='your-structured-json-model'
INGREDIENT_MENU_AI_TIMEOUT_SECONDS='25'
INGREDIENT_MENU_AI_MAX_TOKENS='900'

# -----------------------------------------------------------------------------
# Intelligent Document Screening (local OCR; disabled by default)
# -----------------------------------------------------------------------------
# This module sends no document or OCR text to an external provider. Configure
# absolute paths only after installing and hardening local Tesseract/Poppler.
DOCUMENT_SCREENING_ENABLED='false'
# false uses scripts/process_document_screening_queue.php. Inline processing is
# intended only for local development or hosts without a scheduler.
DOCUMENT_SCREENING_PROCESS_INLINE='false'
DOCUMENT_OCR_TESSERACT_BIN='C:\Program Files\Tesseract-OCR\tesseract.exe'
DOCUMENT_OCR_PDFTOTEXT_BIN='C:\Program Files\poppler\Library\bin\pdftotext.exe'
DOCUMENT_OCR_PDFTOPPM_BIN='C:\Program Files\poppler\Library\bin\pdftoppm.exe'
DOCUMENT_OCR_LANGUAGE='eng'
DOCUMENT_OCR_SECONDARY_PSM='11'
DOCUMENT_OCR_MAX_FILE_BYTES='20971520'
DOCUMENT_OCR_MAX_PAGES='10'
# Full OCR text is temporary; structured fields and review decisions are kept.
DOCUMENT_SCREENING_TEXT_RETENTION_DAYS='14'
# Optional contextual explanations receive only document type, field-presence
# flags and deterministic outcomes—never files, OCR text, values, or paths.
# Enable only after the provider data-processing arrangement is approved.
DOCUMENT_SCREENING_AI_ENABLED='false'
DOCUMENT_SCREENING_AI_ENDPOINT='https://your-provider.example/v1/chat/completions'
DOCUMENT_SCREENING_AI_API_KEY='replace-with-server-side-ai-key'
DOCUMENT_SCREENING_AI_MODEL='your-structured-json-model'
DOCUMENT_SCREENING_AI_TIMEOUT_SECONDS='20'
