# =============================================================================
# Halal Keeps — .htaccess
# Compatible with InfinityFree / shared cPanel hosting
# =============================================================================

# -----------------------------------------------------------------------------
# Rewrite engine — required for BASE_URL auto-detection and clean URLs
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Production: app lives at the domain root (APP_SUBFOLDER is empty).
    # Local XAMPP: change RewriteBase to /halal_final_dev/ to match your subfolder.
    RewriteBase /

    # Allow direct access to real files and directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Route everything else through index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# -----------------------------------------------------------------------------
# HTTPS redirect — active on production (InfinityFree provides free SSL)
# Comment out if testing over HTTP first
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\. [NC]
    RewriteCond %{HTTP_HOST} !^192\.168\. [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# -----------------------------------------------------------------------------
# Block direct access to sensitive files
# (.htaccess, .env, composer files, .git, .user.ini)
# -----------------------------------------------------------------------------
<FilesMatch "(^\.env|^\.user\.ini|composer\.(json|lock)|^\.git|^\.htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block PHP execution inside the uploads directory (prevent webshell uploads)
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} ^/uploads/.*\.php$ [NC]
    RewriteRule ^ - [F,L]
</IfModule>

# -----------------------------------------------------------------------------
# Compression — speeds up page loads
# (mod_deflate is available on InfinityFree)
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# -----------------------------------------------------------------------------
# Browser caching for static assets
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css               "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg             "access plus 1 month"
    ExpiresByType image/png              "access plus 1 month"
    ExpiresByType image/webp             "access plus 1 month"
    ExpiresByType image/svg+xml          "access plus 1 month"
    ExpiresByType application/json       "access plus 1 day"
</IfModule>

# -----------------------------------------------------------------------------
# NOTE: PHP settings (upload limits, memory, display_errors) are controlled
# via .user.ini in the project root — InfinityFree uses CGI/FastCGI so
# php_value / php_flag directives inside .htaccess are NOT supported.
# mod_headers is also not available on InfinityFree.
# -----------------------------------------------------------------------------
